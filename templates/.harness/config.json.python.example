{
  "project_type": "python",
  "fingerprint_exclude": [".git/", "__pycache__/", "*.pyc", "*.egg-info/", ".venv/", "venv/", "dist/", "build/", ".DS_Store"],
  "verification": {
    "commands": [
      {
        "id": "typecheck",
        "command": ["python", "-m", "mypy", "."],
        "required_for_passing": true,
        "timeout_seconds": 300,
        "command_origin": "configured",
        "confirmation": "not_required",
        "applies_when": { "has_files": ["pyproject.toml", "setup.py", "mypy.ini"] }
      },
      {
        "id": "lint",
        "command": ["python", "-m", "ruff", "check", "."],
        "required_for_passing": false,
        "timeout_seconds": 120,
        "command_origin": "configured",
        "confirmation": "not_required",
        "applies_when": { "has_files": ["pyproject.toml", "ruff.toml", ".ruff.toml"] }
      },
      {
        "id": "unit-test",
        "command": ["python", "-m", "pytest"],
        "required_for_passing": true,
        "timeout_seconds": 600,
        "command_origin": "configured",
        "confirmation": "not_required"
      }
    ]
  }
}