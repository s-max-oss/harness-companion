{
  "project_type": "node",
  "fingerprint_exclude": ["node_modules/", ".git/", "dist/", "build/", "coverage/", ".DS_Store", "Thumbs.db"],
  "verification": {
    "commands": [
      {
        "id": "typecheck",
        "command": ["npx", "tsc", "--noEmit"],
        "required_for_passing": true,
        "timeout_seconds": 300,
        "command_origin": "configured",
        "confirmation": "not_required"
      },
      {
        "id": "lint",
        "command": ["npm", "run", "lint"],
        "required_for_passing": false,
        "timeout_seconds": 120,
        "command_origin": "configured",
        "confirmation": "not_required",
        "applies_when": { "has_files": ["package.json"] }
      },
      {
        "id": "unit-test",
        "command": ["npm", "run", "test"],
        "required_for_passing": true,
        "timeout_seconds": 600,
        "command_origin": "configured",
        "confirmation": "not_required"
      }
    ]
  }
}